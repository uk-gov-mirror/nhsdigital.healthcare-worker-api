# ------------------------------ TEST DETAILS ------------------------------
# This section contains test specific details, they are not included as part
# of the AMI build, and so can be configured separately for each test.
# If you add a new variable to section, make sure to also update the
# launch_nft_test.bash script so that the value is passed through.
# --------------------------------------------------------------------------
ENV=ft
CLIENT_ID=KG8XEhXyL0iHP3wN8hKM6KVgDInd2DX0

USERS=20
RAMP_UP=0.1
DURATION=10m
WORKER_COUNT=4
REALM_URL=https://internal-dev.api.service.nhs.uk/oauth2/token

