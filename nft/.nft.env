# ------------------------------ TEST DETAILS ------------------------------
# This section contains test specific details, they are not included as part
# of the AMI build, and so can be configured separately for each test.
# If you add a new variable to section, make sure to also update the
# launch_nft_test.bash script so that the value is passed through.
# --------------------------------------------------------------------------
ENV=ft
CLIENT_ID=

USERS=20
RAMP_UP=0.1
DURATION=10m
WORKER_COUNT=4

# ----------------------------- RUNNER DETAILS -----------------------------
# This section contains details about the EC2 runner used for the NFT tests.
# Any change to these values requires a fresh AMI build.
# --------------------------------------------------------------------------
INSTANCE_TYPE="t2.medium"
SUBNET_ID="subnet-0cb066b029b1c497a"
SECURITY_GROUP_ID="sg-01d2bc8cd327c3cc0"
