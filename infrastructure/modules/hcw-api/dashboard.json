            "y": 18,
            "x": 0,
            "type": "log",
            "properties": {
                "query": "SOURCE '/aws/lambda/hcw-app-${env}' | stats avg(ms), min(ms), max(ms) by bin(30s)\n| filter @message like \"Sending response after\"\n| sort @timestamp desc\n| limit 10000",
                "region": "eu-west-2",
                "stacked": false,
                "title": "Logged response times (milliseconds)",
                "view": "timeSeries"
            }
        },
        {
