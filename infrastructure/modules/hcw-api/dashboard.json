                "title": "API GW Latency - Avg",
                "view": "timeSeries"
            }
        },
        {
            "height": 6,
            "width": 6,
            "y": 12,
            "x": 12,
            "type": "metric",
            "properties": {
                "metrics": [
                    [ "AWS/ApiGateway", "Latency", "ApiName", "hcw-api-${env}", "Stage", "live", { "region": "eu-west-2" } ]
