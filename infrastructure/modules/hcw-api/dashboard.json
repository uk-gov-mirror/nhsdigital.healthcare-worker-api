                    [ "AWS/Lambda", "Duration", "FunctionName", "hcw-app-${env}", "Resource", "hcw-app-${env}:live" ]
                ],
                "region": "eu-west-2",
                "title": "Lambda Duration - Avg"
            }
        },
        {
            "type": "metric",
            "x": 18,
            "y": 12,
            "width": 6,
            "height": 6,
            "properties": {
                "metrics": [
                    [ "AWS/Lambda", "Duration", "FunctionName", "hcw-app-${env}", "Resource", "hcw-app-${env}:live", { "region": "eu-west-2" } ]
