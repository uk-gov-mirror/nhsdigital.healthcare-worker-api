    "item": [
        {
            "name": "Generate JWT",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "exec": [
                            "const moment = require(\"moment\")",
                            "const expireTime = moment().add(5, \"minutes\").unix()",
                            "pm.environment.set(\"expireTime\", expireTime)"
                        ],
                        "type": "text/javascript",
                        "packages": {}
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "console.log(\"in the post response\")",
                            "pm.environment.set(\"authToken\", pm.request.getHeaders()[\"Authorization\"])"
                        ],
                        "type": "text/javascript",
                        "packages": {}
                    }
                }
            ],
            "request": {
                "auth": {
                    "type": "jwt",
                    "jwt": [
                        {
                            "key": "privateKey",
                            "value": "",
                            "type": "string"
                        },
                        {
                            "key": "payload",
                            "value": "{\n    \"sub\": \"{{client_id}}\",\n    \"iss\": \"{{client_id}}\",\n    \"jti\": \"{{$guid}}\",\n    \"aud\": \"{{realm_url}}\",\n    \"exp\": {{expireTime}}\n}",
                            "type": "string"
                        },
                        {
                            "key": "headerPrefix",
                            "value": "",
                            "type": "string"
                        },
                        {
                            "key": "header",
                            "value": "{\n    \"kid\": \"{{key_id}}\",\n    \"typ\": \"JWT\"\n}",
                            "type": "string"
                        },
                        {
                            "key": "algorithm",
                            "value": "RS512",
                            "type": "string"
                        },
                        {
                            "key": "isSecretBase64Encoded",
                            "value": false,
                            "type": "boolean"
                        },
                        {
                            "key": "addTokenTo",
                            "value": "header",
                            "type": "string"
                        },
                        {
                            "key": "queryParamKey",
                            "value": "token",
                            "type": "string"
                        }
                    ]
                },
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "www.example.com",
                    "host": [
                        "www",
                        "example",
                        "com"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Auth",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "exec": [
                            ""
                        ],
                        "type": "text/javascript",
                        "packages": {}
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.environment.set(\"access_token\", pm.response.json()[\"access_token\"])"
                        ],
                        "type": "text/javascript",
                        "packages": {}
                    }
                }
            ],
            "request": {
                "auth": {
                    "type": "noauth"
                },
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "urlencoded",
                    "urlencoded": [
                        {
                            "key": "grant_type",
                            "value": "client_credentials",
                            "type": "text"
                        },
                        {
                            "key": "client_assertion_type",
                            "value": "urn:ietf:params:oauth:client-assertion-type:jwt-bearer",
                            "type": "text"
                        },
                        {
                            "key": "client_assertion",
                            "value": "{{authToken}}",
                            "type": "text"
                        }
                    ]
                },
                "url": {
                    "raw": "{{realm_url}}",
                    "host": [
                        "{{realm_url}}"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Get Practitioner",
